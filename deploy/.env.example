# Copy to .env (never commit it).
SITE_ADDRESS=blastradius.example.com   # a hostname you control, or <ip-with-dashes>.sslip.io, or :80 for HTTP only
FALKOR_PASSWORD=change-me-to-a-long-random-string
# Optional:
GEMINI_API_KEY=       # free tier key from aistudio.google.com; without it the offline router answers
GITHUB_TOKEN=         # read-only, lifts the 60 req/h anonymous GitHub API limit for "analyse a repo"
